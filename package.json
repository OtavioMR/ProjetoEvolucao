{
  "name": "projeto-evolucao",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare": "node scripts/prepare-preset.mjs",
    "prestart": "npm run prepare",
    "start": "expo start",
    "android": "expo start --android",
    "android:build": "expo run:android --variant release",
    "web": "expo start --web",
    "build": "expo export --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:db": "node --experimental-strip-types --test src/test/database.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:db && npm run format:check",
    "preandroid": "npm run prepare",
    "preweb": "npm run prepare",
    "prebuild": "npm run prepare",
    "preandroid:build": "npm run prepare"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^7.0.9",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >=26.0.0"
  }
}
